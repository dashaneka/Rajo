[Desktop Entry]
Type=Application
Name=Rajo
GenericName=Image Viewer
Comment=Look at images
Exec=rajo %U
Icon=io.github.rajnish.Rajo
Terminal=false
StartupNotify=true
Categories=GTK;GNOME;Graphics;Viewer;2DimensionalGraphics;
Keywords=image;photo;picture;viewer;gallery;
MimeType=image/jpeg;image/jpg;image/pjpeg;image/png;image/gif;image/bmp;image/x-bmp;image/x-ms-bmp;image/webp;image/svg+xml;image/tiff;image/x-tga;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/avif;image/heic;image/heif;
